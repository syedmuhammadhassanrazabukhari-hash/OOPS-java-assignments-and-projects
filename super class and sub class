public class Main {
    public static void main(String[] args) {
        System.out.println("=======================================================");
        System.out.println("            GEOMETRIC SHAPES DEMO                      ");
        System.out.println("=======================================================\n");

        Point p1 = new Point(0, 0);
        Point p2 = new Point(3, 4);
        Point p3 = new Point(0, 4);
