import java.util.ArrayList;
import java.util.List;

interface Drivable {
    void startEngine();
    void stopEngine();
    void accelerate(double speed);
}

interface Maintainable {
    void serviceVehicle();
    void serviceVehicle(String serviceType);
}

interface OffRoadCapable {
    void enable4WD();
    void disable4WD();
}

class Point {
    private double x;
    private double y;
    private double z;

    public Point(double x, double y) {
        this.x = x;
        this.y = y;
        this.z = 0.0;
    }

    public Point(double x, double y, double z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }

    public double getX() { return x; }
    public double getY() { return y; }
    public double getZ() { return z; }

    public double distanceTo(Point other) {
        double dx = this.x - other.x;
        double dy = this.y - other.y;
        double dz = this.z - other.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    public void display() {
        System.out.println("Point Coordinates: (" + x + ", " + y + ", " + z + ")");
    }
}

class Line {
    private Point start;
    private Point end;

    public Line(Point start, Point end) {
        this.start = start;
        this.end = end;
    }

    public double getLength() {
        return start.distanceTo(end);
    }

    public void display() {
        System.out.println("Line: [Start: (" + start.getX() + ", " + start.getY() + ") -> End: (" 
                + end.getX() + ", " + end.getY() + ")] | Length: " + String.format("%.2f", getLength()));
    }
}

class Triangle {
    private Point p1;
    private Point p2;
    private Point p3;

    public Triangle(Point p1, Point p2, Point p3) {
        this.p1 = p1;
        this.p2 = p2;
        this.p3 = p3;
    }

    public double getPerimeter() {
        double side1 = p1.distanceTo(p2);
        double side2 = p2.distanceTo(p3);
        double side3 = p3.distanceTo(p1);
        return side1 + side2 + side3;
    }

    public double getArea() {
        double side1 = p1.distanceTo(p2);
        double side2 = p2.distanceTo(p3);
        double side3 = p3.distanceTo(p1);
        double s = getPerimeter() / 2.0;
        return Math.sqrt(s * (s - side1) * (s - side2) * (s - side3));
    }

    public void display() {
        System.out.println("Triangle | Area: " + String.format("%.2f", getArea()) 
                + " | Perimeter: " + String.format("%.2f", getPerimeter()));
    }
}

class Square {
    private Point topLeft;
    private double sideLength;

    public Square(Point topLeft, double sideLength) {
        this.topLeft = topLeft;
        this.sideLength = sideLength;
    }

    public double getArea() {
        return sideLength * sideLength;
    }

    public double getPerimeter() {
        return 4 * sideLength;
    }

    public void display() {
        System.out.println("Square [Top-Left: (" + topLeft.getX() + ", " + topLeft.getY() 
                + "), Side: " + sideLength + "] | Area: " + String.format("%.2f", getArea()) 
                + " | Perimeter: " + String.format("%.2f", getPerimeter()));
    }
}

class Sphere {
    private Point center;
    private double radius;

    public Sphere(Point center, double radius) {
        this.center = center;
        this.radius = radius;
    }

    public double getVolume() {
        return (4.0 / 3.0) * Math.PI * Math.pow(radius, 3);
    }

    public double getSurfaceArea() {
        return 4.0 * Math.PI * Math.pow(radius, 2);
    }

    public void display() {
        System.out.println("Sphere [Center: (" + center.getX() + ", " + center.getY() + ", " + center.getZ() 
                + "), Radius: " + radius + "] | Volume: " + String.format("%.2f", getVolume()) 
                + " | Surface Area: " + String.format("%.2f", getSurfaceArea()));
    }
}

class Vehicle implements Drivable, Maintainable {
    protected String make;
    protected String model;
    protected int year;
    protected double currentSpeed;
    protected boolean isEngineRunning;

    public Vehicle(String make, String model, int year) {
        this.make = make;
        this.model = model;
        this.year = year;
        this.currentSpeed = 0.0;
        this.isEngineRunning = false;
    }

    @Override
    public void startEngine() {
        this.isEngineRunning = true;
        System.out.println("[Vehicle] " + getFullName() + " engine started.");
    }

    @Override
    public void stopEngine() {
        this.isEngineRunning = false;
        this.currentSpeed = 0.0;
        System.out.println("[Vehicle] " + getFullName() + " engine shut down.");
    }

    @Override
    public void accelerate(double speed) {
        if (!isEngineRunning) {
            System.out.println("[Vehicle] Cannot accelerate " + getFullName() + ". Engine is off!");
            return;
        }
        this.currentSpeed += speed;
        System.out.println("[Vehicle] " + getFullName() + " accelerated by " + speed 
                + " km/h. Current speed: " + currentSpeed + " km/h.");
    }

    @Override
    public void serviceVehicle() {
        System.out.println("[Vehicle] Performing standard maintenance on " + getFullName() + ".");
    }

    @Override
    public void serviceVehicle(String serviceType) {
        System.out.println("[Vehicle] Performing specialized " + serviceType + " service on " + getFullName() + ".");
    }

    public void displaySpecs() {
        System.out.println("Vehicle Specs: " + year + " " + make + " " + model 
                + " | Current Speed: " + currentSpeed + " km/h");
    }

    public void soundHorn() {
        System.out.println("[Vehicle] Standard Beep Beep!");
    }

    public void refuel() {
        System.out.println("[Vehicle] Refueling " + getFullName() + " with standard grade fuel to maximum capacity.");
    }

    public void refuel(double liters) {
        System.out.println("[Vehicle] Added " + liters + " liters of standard fuel to " + getFullName() + ".");
    }

    public void refuel(double liters, String fuelType) {
        System.out.println("[Vehicle] Added " + liters + " liters of " + fuelType + " fuel to " + getFullName() + ".");
    }

    public void refuel(String fuelType, double costPerLiter) {
        System.out.println("[Vehicle] Filling " + getFullName() + " with " + fuelType + " at $" + costPerLiter + " per liter.");
    }

    public String getFullName() {
        return year + " " + make + " " + model;
    }
}

class Car extends Vehicle {
    protected int doorCount;
    protected int seatingCapacity;

    public Car(String make, String model, int year, int doorCount, int seatingCapacity) {
        super(make, model, year);
        this.doorCount = doorCount;
        this.seatingCapacity = seatingCapacity;
    }

    @Override
    public void displaySpecs() {
        System.out.println("Car Specs: " + year + " " + make + " " + model 
                + " | Doors: " + doorCount + " | Seats: " + seatingCapacity);
    }

    @Override
    public void soundHorn() {
        System.out.println("[Car] Honk Honk!");
    }

    public void driveMode() {
        System.out.println("[Car] Switched to Normal Drive Mode.");
    }

    public void driveMode(String mode) {
        System.out.println("[Car] Switched drive mode to custom preset: " + mode + ".");
    }

    public void driveMode(String mode, boolean tractionControl) {
        System.out.println("[Car] Switched to " + mode + " Mode. Traction Control: " 
                + (tractionControl ? "ON" : "OFF") + ".");
    }
}

class Sedan extends Car {
    private double trunkCapacityLiters;
    private boolean luxuryInterior;

    public Sedan(String make, String model, int year, double trunkCapacityLiters, boolean luxuryInterior) {
        super(make, model, year, 4, 5);
        this.trunkCapacityLiters = trunkCapacityLiters;
        this.luxuryInterior = luxuryInterior;
    }

    @Override
    public void displaySpecs() {
        System.out.println("Sedan Specs: " + year + " " + make + " " + model 
                + " | Trunk: " + trunkCapacityLiters + "L | Luxury Package: " 
                + (luxuryInterior ? "Yes" : "No"));
    }

    @Override
    public void soundHorn() {
        System.out.println("[Sedan] Smooth Soft Honk...");
    }

    public void openTrunk() {
        System.out.println("[Sedan] Trunk manually opened.");
    }

    public void openTrunk(boolean useKeyFob) {
        if (useKeyFob) {
            System.out.println("[Sedan] Trunk popped remotely using Smart Key Fob.");
        } else {
            openTrunk();
        }
    }

    public void openTrunk(String gesture) {
        System.out.println("[Sedan] Trunk opened using " + gesture + " foot-sensor activation.");
    }
}

class SUV extends Car implements OffRoadCapable {
    private boolean is4WDActive;
    private double groundClearanceInches;

    public SUV(String make, String model, int year, double groundClearanceInches) {
        super(make, model, year, 4, 7);
        this.is4WDActive = false;
        this.groundClearanceInches = groundClearanceInches;
    }

    @Override
    public void displaySpecs() {
        System.out.println("SUV Specs: " + year + " " + make + " " + model 
                + " | Ground Clearance: " + groundClearanceInches + " in | 4WD Status: " 
                + (is4WDActive ? "ENGAGED" : "DISENGAGED"));
    }

    @Override
    public void soundHorn() {
        System.out.println("[SUV] Deep Loud Horn BARK!");
    }

    @Override
    public void enable4WD() {
        this.is4WDActive = true;
        System.out.println("[SUV] 4WD System engaged. Transfer case locked.");
    }

    @Override
    public void disable4WD() {
        this.is4WDActive = false;
        System.out.println("[SUV] 4WD System disengaged. Reverted to 2WD mode.");
    }

    public void calculateTowingLimit() {
        System.out.println("[SUV] Standard towing limit: 3,500 lbs.");
    }

    public void calculateTowingLimit(boolean hasTowPackage) {
        double limit = hasTowPackage ? 7500.0 : 3500.0;
        System.out.println("[SUV] Towing limit with package option: " + limit + " lbs.");
    }

    public void calculateTowingLimit(double cargoWeight, int passengers) {
        double maxCapacity = 7500.0 - (cargoWeight + (passengers * 150.0));
        System.out.println("[SUV] Available towing allowance under current load: " + maxCapacity + " lbs.");
    }
}

