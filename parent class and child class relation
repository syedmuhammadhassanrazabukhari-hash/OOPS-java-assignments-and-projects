import java.util.ArrayList;
import java.util.List;

class Dino {
    protected String name;
    protected String diet;
    protected double weightKg;

    public Dino(String name, String diet, double weightKg) {
        this.name = name;
        this.diet = diet;
        this.weightKg = weightKg;
    }

    public void makeSound() {
        System.out.println(name + " utters a low, rumbling roar!");
    }

    @Override
    public String toString() {
        return "Dino [Name: " + name + ", Diet: " + diet + ", Weight: " + weightKg + " kg]";
    }
}

class FlyingDino extends Dino {
    private double wingspanMeters;

    public FlyingDino(String name, String diet, double weightKg, double wingspanMeters) {
        super(name, diet, weightKg);
        this.wingspanMeters = wingspanMeters;
    }

    public void fly() {
        System.out.println(name + " soars into the sky with a " + wingspanMeters + "m wingspan!");
    }

    @Override
    public void makeSound() {
        System.out.println(name + " lets out a piercing high-pitched screech!");
    }

    @Override
    public String toString() {
        return "FlyingDino [Name: " + name + ", Wingspan: " + wingspanMeters + "m, Diet: " + diet + ", Weight: " + weightKg + " kg]";
    }
}

class SeaDino extends Dino {
    private double maxSwimDepthMeters;

    public SeaDino(String name, String diet, double weightKg, double maxSwimDepthMeters) {
        super(name, diet, weightKg);
        this.maxSwimDepthMeters = maxSwimDepthMeters;
    }

    public void swim() {
        System.out.println(name + " dives down to " + maxSwimDepthMeters + " meters deep!");
    }

    @Override
    public void makeSound() {
        System.out.println(name + " releases deep sonar clicks underwater!");
    }

    @Override
    public String toString() {
        return "SeaDino [Name: " + name + ", Max Depth: " + maxSwimDepthMeters + "m, Diet: " + diet + ", Weight: " + weightKg + " kg]";
    }
}

class LandDino extends Dino {
    private double topRunningSpeedKmH;

    public LandDino(String name, String diet, double weightKg, double topRunningSpeedKmH) {
        super(name, diet, weightKg);
        this.topRunningSpeedKmH = topRunningSpeedKmH;
    }

    public void run() {
        System.out.println(name + " charges across the land at " + topRunningSpeedKmH + " km/h!");
    }

    @Override
    public void makeSound() {
        System.out.println(name + " lets out a ground-shaking roar!");
    }

    @Override
    public String toString() {
        return "LandDino [Name: " + name + ", Top Speed: " + topRunningSpeedKmH + " km/h, Diet: " + diet + ", Weight: " + weightKg + " kg]";
    }
}

public class Main {
    public static void main(String[] args) {
        FlyingDino ptero = new FlyingDino("Pterodactyl", "Carnivore", 25.0, 3.5);
        FlyingDino quetzal = new FlyingDino("Quetzalcoatlus", "Carnivore", 220.0, 11.0);

        SeaDino mosasaur = new SeaDino("Mosasaurus", "Carnivore", 15000.0, 500.0);
        SeaDino plesio = new SeaDino("Plesiosaurus", "Piscivore", 500.0, 150.0);

        LandDino trex = new LandDino("T-Rex", "Carnivore", 8000.0, 27.0);
        LandDino triceratops = new LandDino("Triceratops", "Herbivore", 6000.0, 32.0);
        LandDino raptor = new LandDino("Velociraptor", "Carnivore", 15.0, 60.0);

        List<Dino> dinoPark = new ArrayList<>();
        dinoPark.add(ptero);
        dinoPark.add(quetzal);
        dinoPark.add(mosasaur);
        dinoPark.add(plesio);
        dinoPark.add(trex);
        dinoPark.add(triceratops);
        dinoPark.add(raptor);

        System.out.println("=== DINOSAUR PARK INVENTORY ===");
        for (Dino d : dinoPark) {
            System.out.println(d);
            d.makeSound();
            System.out.println("------------------------------------------------");
        }

        System.out.println("\n=== SPECIALIZED SUBCLASS ACTIONS ===");
        ptero.fly();
        mosasaur.swim();
        trex.run();
    }
}
