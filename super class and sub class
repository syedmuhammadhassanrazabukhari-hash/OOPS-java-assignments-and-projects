        System.out.println("=======================================================\n");

        Car mercedesAMG = new Car("Mercedes-AMG", "GT Coupe", 2024, 2, 2);
        Sedan mercedesSClass = new Sedan("Mercedes-Benz", "S-Class S580", 2025, 535.0, true);
        Sedan toyotaCamry = new Sedan("Toyota", "Camry XSE", 2023, 427.5, false);
        SUV gWagon = new SUV("Mercedes-Benz", "G-Class G63 AMG", 2024, 9.5);
        SUV cadillacEscalade = new SUV("Cadillac", "Escalade ESV", 2023, 8.0);
        Motorcycle yamahaR1 = new Motorcycle("Yamaha", "YZF-R1", 2024, "Clip-on");
        Motorcycle harleyDavidson = new Motorcycle("Harley-Davidson", "Street Glide", 2022, "Ape Hanger", false);

        mercedesAMG.refuel();
        mercedesAMG.refuel(65.5);
        mercedesAMG.refuel(65.5, "93 Octane Premium Unleaded");
        mercedesAMG.refuel("100 Octane Race Fuel", 4.25);
        System.out.println();

        mercedesSClass.driveMode();
        mercedesSClass.driveMode("Sport Plus");
        mercedesSClass.driveMode("Eco Pro", false);
        System.out.println();

        toyotaCamry.openTrunk();
        toyotaCamry.openTrunk(true);
        toyotaCamry.openTrunk("Hands-free Kick");
        System.out.println();

        gWagon.calculateTowingLimit();
        gWagon.calculateTowingLimit(true);
        gWagon.calculateTowingLimit(500.0, 4);
        System.out.println();

        yamahaR1.performWheelie();
        yamahaR1.performWheelie(150.0);
        yamahaR1.performWheelie(300.0, "Stand-up");
